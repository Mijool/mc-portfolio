---
// src/pages/projects.astro
// All the projects I want to show off are instantiated and stored here, makes it super easy to come back and edit/update anything I need to


// to have both a thumbnail and viewable iframe for the longer files, I need to have both a png/jpeg and a pdf
const PROJECTS = [
  {
    title: "Python Simplex Web App",
    thumbnail: "/artifacts/Simplex Web App by MC.png",
      artifactPDF: "/artifacts/Simplex Web App by MC.png",
    description:
        "https://tinyurl.com/mc-simplex \n" +
        "or https://simplex-web-project-by-miguelcamarena.vercel.app/ \n" +
        "React + Typescript frontend & FastAPI + Python backend application that takes a linear program from user input, executes the logic to solve the problem, and displays a 2D visual representation of its optimal solution. The project is hosted online through Vercel and highlights my understanding of converting advanced mathematical concepts into practical, real-world applications"
  },
  {
    title: "R Managerial Analytics",
    thumbnail: "/artifacts/Group-3-R-scripts---Miguel,-Joshua-04.png",
      artifactPDF: "/artifacts/Group-3-R-scripts---Miguel,-Joshua.pdf",
    description:
        "Co-developed an automated R pipeline via dplyr and tidyr to clean and reshape fragmented Excel datasets into relational formats." +
        " Programmed statistical KPI models and compiled visualized downtime drivers on an academic report using Pareto charts and" +
        "corrplot matrices via ggplot2 & kniter."
  },
  {
    title: "Aim2Flourish",
    thumbnail: "/artifacts/AIM2Flourish _ British Manufacturing Company Becomes Industry Leader…-1.png",
      artifactPDF: "/artifacts/AIM2Flourish _ British Manufacturing Company Becomes Industry Leader….pdf",
    description:
        "https://aim2flourish.com/innovations/british-manufacturing-company-becomes-industry-leader-in-safety \n" +
        "I collaborated closely with peers locally and overseas (Chicago, Guelph, Wales) to conduct an interview and" +
        "publish an article on SPTS, a UK microelectronics machinery manufacturer. Through means of online" +
        "communication, coordination, and dedication, we completed the project in under five weeks and had our work" +
        "published to aim2flourish.com."
  },
  {
    title: "CV 400 Career Transition Form",
    thumbnail: "/artifacts/CamarenaMiguel_Career_Vocation_Planning_Redesigned_Fall_2026-1.png",
      artifactPDF: "/artifacts/CamarenaMiguel_Career_Vocation_Planning_Redesigned_Fall_2026.pdf",
    description:
        "Assignment done as part of DUs Career and Vocation course meant to have me reflect on my transition out of college."
  },
  {
    title: "Cover Letter",
    thumbnail: "/artifacts/Camarena_Miguel_Cover_Letter-1.png",
      artifactPDF: "/artifacts/Camarena_Miguel_Cover_Letter.pdf",
    description:
        "My most Recent Cover Letter"
  },
  {
    title: "Resume",
    thumbnail: "/artifacts/Camarena_Miguel_2026Q4-1.png",
      artifactPDF: "/artifacts/Camarena_Miguel_2026Q4.pdf",
    description:
        "My Resume Dated Q4 2026"
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Projects - Miguel Camarena</title>
  </head>
  <body>
    <nav>
      <a href="/">Home - M. Camarena</a>
      <div>
        <a href="https://www.linkedin.com/in/mcamarena1/" target="_blank">LinkedIn - mcamarena1</a>
        <a href="mailto:mcamarena@my.dom.edu">Email: mcamarena@my.dom.edu</a>
        <a href="https://github.com/mijool/" target="_blank">GitHub</a>
      </div>
    </nav>

    <main>
      <h1>My Projects</h1> <!-- Idea for projects is to mirror the Wix version, each project is displayed and when clicked on shows more information. Instead of loading another page, I have everything load in the background and is shown within a pop-up window (Modal)-->

      <!-- Flexbox Grid for Projects -->
        <!-- Similar to React, the .map function loads everything inside the call for each element in the projects dictionary-->
      <section class="projects-grid">
        {PROJECTS.map((project) => (
                <div class="project-wrapper">

                  <h3 class="project-title">{project.title}</h3>

                <div
                    class="project-card"
                    data-title={project.title}
                    data-desc={project.description}
                    data-src={project.artifactPDF}
                  >

                <!-- object-fit: cover in the CSS handles the cropping of the actual image -->
                <img src={project.thumbnail} alt={project.title} loading="lazy" />
                <div class="card-overlay">
                  <span>Read More</span>
                </div>

                </div>
                </div>

        ))}
      </section>
    </main>

    <!-- The Modal -->
    <div id="project-modal" class="modal-backdrop hidden">
      <div class="modal-content">
        <button id="close-modal" aria-label="Close modal">&times;</button>

        <div class="modal-left">
          <iframe id="modal-iframe" src="" loading="lazy"></iframe>
        </div>

        <div class="modal-right">
          <h2 id="modal-title">Project Title</h2>
          <p id="modal-desc" class="modal-descriptor">Project Description goes here.</p>
        </div>
      </div>
    </div>

    <!-- Client-side script to handle Modal interactions -->
    <script>
      const cards = document.querySelectorAll('.project-card');
      const modal = document.getElementById('project-modal');
      const closeBtn = document.getElementById('close-modal');
      const iframe  = document.getElementById('modal-iframe');
      const titleEl = document.getElementById('modal-title');
      const descEl = document.getElementById('modal-desc');
    /* each mapped element has it's neccessary data stored so that each card modal has it's relevant information loaded on click */
      // Open modal on card click
      cards.forEach(card => {
        card.addEventListener('click', () => {
          titleEl.textContent = card.getAttribute('data-title');
          descEl.textContent = card.getAttribute('data-desc');
          iframe.src = card.getAttribute('data-src');
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden'; // Prevent background scrolling
        });
      });

      // Close modal function
      const closeModal = () => {
        modal.classList.add('hidden');
        iframe.src = ''; // Stop iframe execution when closed
        document.body.style.overflow = '';
      };

      // Close on X click
      closeBtn.addEventListener('click', closeModal);

      // Close on clicking outside the modal content
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    </script>
  </body>
</html>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #121316;
    color: #fff;
    font-family: "Courier New", Courier, monospace;
    min-height: 100vh;
  }

  /* Navigation Bar */
  nav {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.5rem 2.5rem;
    background: linear-gradient(180deg, #5b0606, transparent);
  }

  nav a {
    color: #c3bfbf;
    margin-right: 1.5rem;
    text-decoration: underline;
    transition: 0.2s;
    font-size: clamp(1.2rem, 1.8vw, 1rem);
    font-weight: 900;
  }

  nav a:hover { color: #c8c5a2; }

  /* Main Container */
  main {
    max-width: 80vw;
    margin: 0 auto;
    padding: 2rem 2rem;
  }

  h1 {
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    font-weight: 900;
    margin-bottom: 2rem;
    text-align: center;
  }

  /* Projects Flexbox Grid */
  .projects-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: center;
  }
  .project-wrapper{
      flex: 1 1 300px;
      max-width: 33rem;
      display: flex;
      flex-direction: column;
      gap: .8rem;
  }

  .project-title{
      font-size: 1.1rem;
      font-weight: 700;
      color: #e5b3b3;
      margin: 0;
      text-align: left;
      font-family: "Courier New", Courier, monospace;
  }

  .modal-descriptor{
      white-space: pre-line;
  }

  /* Individual Project Card */
  .project-card {
    aspect-ratio: 4 / 3;
    position: relative;
    cursor: pointer;
    border: 1px solid #7a1515;
    overflow: hidden;
    background: #000;
      width: 100%;
  }

  .project-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }


  /* Dark Overlay on Hover */
  .card-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card-overlay span {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 900;
    border: 1px solid #7a1515;
    padding: 0.8rem 1.5rem;
  }

  .project-card:hover .card-overlay { opacity: 1; }
  .project-card:hover img { transform: scale(1.05); }

  /* Modal Styles */
  .modal-backdrop {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .modal-backdrop.hidden {
    display: none;
  }

  .modal-content {
    background: #121316;
    border: 2px solid #5b0606;
    width: 100%;
    max-width: 1100px;
    height: 80vh;
    display: flex;
    position: relative;
    box-shadow: 0 0 30px rgba(139, 0, 0, 0.4);
  }

  #close-modal {
    position: absolute;
    top: -1.5rem;
    right: -1.5rem;
    background: #5b0606;
    color: white;
    border: none;
    font-size: 2rem;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    border-radius: 50%;
    z-index: 10;
  }

  #close-modal:hover { background: #ff3333; }

  /* Modal Layout: Left (Iframe) / Right (Text) */
  .modal-left {
    flex: 2; /* takes up roughly 66% */
    border-right: 1px solid #5b0606;
  }

  .modal-left iframe {
    width: 100%;
    height: 100%;
    border: none;
    background: #fff;
  }

  .modal-right {
    flex: 1; /* takes up roughly 33% */
    padding: 2.5rem;
    overflow-y: auto;
  }

  .modal-right h2 {
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
    color: #e5b3b3;
  }

  .modal-right p {
    color: #c3c7cf;
    line-height: 1.6;
    font-family: sans-serif;
  }

  /* Responsive Modal for Mobile */
  @media (max-width: 800px) {
    .modal-content {
      flex-direction: column;
    }
    .modal-left {
      border-right: none;
      border-bottom: 1px solid #5b0606;
      flex: 1;
      height: 50%;
    }
    .modal-right {
      height: 50%;
      padding: 1.5rem;
    }
    #close-modal {
      top: 0.5rem;
      right: 0.5rem;
    }
  }
</style>